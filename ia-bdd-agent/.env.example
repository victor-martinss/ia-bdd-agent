# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env não é versionado (contém segredos).

BITRIX_WEBHOOK=https://SEU_DOMINIO.bitrix24.com.br/rest/USER/TOKEN

# Opcional: imprime JSON detalhado do CRM no console
# DEBUG_BITRIX=1

# --- IA para BDD (OpenAI ou Ollama; fallback automático para gerador estruturado) ---
# BDD_USE_LLM=1
# BDD_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# BDD_AI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1
# BDD_AI_TEMPERATURE=0.2
# BDD_AI_TIMEOUT_MS=120000
# Com cenários Dev preenchidos, usa gerador estruturado (mais fiel ao CRM). Forçar sempre: BDD_PREFER_STRUCTURED=1
#
# Prompts BDD (pasta prompts/) — ver prompts/README.md
# BDD_PROMPT_MODE=auto
# Modos: default | novo_teste | regressao | defeito | integracao | desktop_portable | dicom_viewer | melhoria | validacao_exata | evidencias | coverage_assertivo
# Cobertura (análise textual): coverage.txt | coverage-validacao-exata.txt | coverage-evidencias.txt
# BDD_PROMPT_FILE=bdd-integracao.txt
# BDD_PROMPT_AUTO=1
# BDD_INCLUDE_VOCAB=1
# Modo assertivo (padrão ligado): descrição, passos, resultados + análise de evidências antes do BDD. Desligar: BDD_ASSERTIVE_MODE=0
# BDD_ASSERTIVE_MODE=1
# Análise de imagens/vídeos anexados pelo Dev (OpenAI Vision). Desligar: BDD_ANALYZE_EVIDENCE=0
# BDD_ANALYZE_EVIDENCE=1
# BDD_VISION_MODEL=gpt-4o
# BDD_EVIDENCE_MAX_IMAGES=4
# Forçar LLM mesmo com Cenários Dev preenchidos: BDD_ASSERTIVE_LLM=1
# Geração legada: somente título + Dev (requer BDD_ASSERTIVE_MODE=0). Desligar: BDD_ONLY_TITLE_AND_DEV=0
# BDD_ONLY_TITLE_AND_DEV=1
# Cenários complementares além do Dev (smoke, negativo, integração). Desligar: BDD_COVERAGE_EXTRA=0
# BDD_COVERAGE_EXTRA=1
# Máximo de cenários extras de cobertura (além dos do Dev)
# BDD_COVERAGE_MAX_EXTRA=3
# Ollama local: BDD_AI_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434/api/generate
# MODEL=llama3

# --- SPA pelo título (ex.: Desenvolvimento Q.A. ou Teste Q.A.) ---
# BITRIX_SMART_PROCESS_TITLE=Desenvolvimento Q.A.
# BITRIX_SMART_PROCESS_TITLE=Teste Q.A.
# Colunas QA (todas as categorias/squads do SPA):
# BITRIX_QA_STAGE_NAMES=Novo Teste,Teste de Q.A,Testes de Q.A,Pronto para teste
# (legado) BITRIX_STAGE_NAME=Novo Teste
# Colunas de desenvolvimento (não recebem cenários no campo QA):
# BITRIX_DEV_STAGE_NAMES=Em Desenvolvimento,Testes em Desenvolvimento
# (opcional) BITRIX_CATEGORY_ID=0
# (opcional) filtro manual: BITRIX_LIST_FILTER_JSON={"STAGE_ID":"DTxxxx_STAGE_y:CODE"}
# Liste tipos e estágios: npm run bitrix:context
# SPA principal (fila QA do poll). Outros processos: passe o id na URL (type/1294/…)
# BITRIX_ENTITY_TYPE_ID=1276
# Poll/bdd: fila QA em vários SPAs (NGF + DICOM, etc.)
BITRIX_ENTITY_TYPE_IDS=1276,1294
# Esteiras/squads (match parcial no nome da categoria). Omitir = todas as categorias do SPA
# BITRIX_QA_CATEGORY_NAMES=DICOM,Sustentação,Improve,Core,NGF
# BITRIX_QA_ALL_CATEGORIES=1
# BITRIX_QA_BROAD_STAGE_MATCH=1
# Desligar probe fixo 1276/1294 (portais com outro conjunto de SPAs):
# BITRIX_DISABLE_BUILTIN_ENTITY_PROBE=1
# Após gerar o BDD, gravar no CRM (campo "Teste Q.A.", "Cenários QA", etc.). Desligar: BITRIX_PUSH_BDD_TO_UF=0
# Código REST do campo (recomendado). Vários SPA = lista separada por vírgula (ordem de tentativa):
# • entityTypeId 1294 (ex.: Squad DICOM / type/1294/) → ufCrm100*
# • entityTypeId 1276 (chamados NGF / type/1276/) → ufCrm94*
BITRIX_UF_BDD_FIELD=ufCrm100CenariosQa,ufCrm94CenariosQa
# (equivalente) BITRIX_UF_CENARIOS_QA ou BITRIX_UF_TESTE_QA
# Horário nos logs do poll (padrão: America/Sao_Paulo / BRT)
# BDD_LOG_TIMEZONE=America/Sao_Paulo
# Não gerar/sobrescrever se cenários QA já existirem no item (principal e cards QA vinculados). Para sempre regerar:
# BITRIX_SKIP_BDD_IF_QA_FILLED=0
# Não gerar em retornos: card já passou por Teste de Q.A. / reprovação e voltou a Novo Teste (crm.stagehistory.list)
# BITRIX_SKIP_BDD_IF_QA_HISTORY=1
# Colunas de retorno no histórico (match parcial no nome do estágio)
# BITRIX_QA_RETURN_STAGE_NAMES=reprov,retorn,devolv,Em Desenvolvimento
# Mesmo com campo já preenchido: preservar o texto acima do marcador e só substituir o bloco IA abaixo desta linha no UF:
# BITRIX_BDD_MERGE_BELOW_MARKER=1
# BITRIX_BDD_APPEND_MARKER=<<<BDD_IA_APPEND>>>
# Lista do Bitrix: tamanho de página (1–500; padrão 100). A lista é buscada em páginas até acabar.
# BITRIX_LIST_PAGE_SIZE=100

# (opcional) Mesmo BDD nas tarefas Bitrix atreladas ao card (UF_CRM_TASK) — precisa UF de texto na TAREFA
# BITRIX_TASK_UF_BDD_FIELD=ufTaskSeuCodigoAqui
# Descoberta automática do UF em tasks.task.get (padrão ligada). Desligar: BITRIX_TASK_UF_AUTO_DISCOVER=0
# Se o get não retornar UFs, liste: BITRIX_TASK_GET_SELECT=ufTaskCampo1,ufTaskCampo2
# Se crm.type.list falhar (400), informe o símbolo do SPA manualmente (ex.: T82):
# BITRIX_SYMBOL_CODE_SHORT=T82
# Valor exato de UF_CRM_TASK na tarefa (use {{id}}, {{entityTypeId}}, {{symbol}}):
# BITRIX_UF_CRM_TASK_VALUE={{symbol}}_{{id}}
# Desligar gravação em tarefas Bitrix: BITRIX_PUSH_BDD_TO_LINKED_TASKS=0
# Desligar gravação em itens CRM filhos: BITRIX_PUSH_BDD_TO_LINKED_CRM_ITEMS=0

# Poll automático da fila QA (consulta repetida ao CRM)
# Ordem de leitura: BDD_POLL_INTERVAL_SECONDS (prioridade), depois BDD_POLL_INTERVAL_MINUTES
# • Padrão: 30 segundos (sem env). Mínimo entre consultas: 10s para não sobrecarregar o Bitrix.
# • Ex.: novo teste quase na hora: BDD_POLL_INTERVAL_SECONDS=15
# • Mais raro na API local: BDD_POLL_INTERVAL_MINUTES=5
# BDD_POLL_INTERVAL_SECONDS=30
# Poll: reprocessar IDs específicos (remove do poll-state e gera de novo)
# BDD_POLL_FORCE_IDS=360
# Poll: reprocessar todos os itens da fila a cada tick
# BDD_POLL_REPROCESS_IN_QUEUE=1

# API HTTP (npm run api) — webhook de saída Bitrix: POST /webhooks/bitrix/outgoing
# Exponha a porta com ngrok / Cloudflare Tunnel para URL pública.
# BITRIX_OUTGOING_WEBHOOK_SECRET=troque_por_um_token_longo
# BITRIX_OUTGOING_ALLOW_QUERY_TOKEN=1
# BITRIX_OUTGOING_PROCESS_SYNC=0
# BDD_OUTGOING_MAX_BODY_BYTES=2097152

# Logar corpo da resposta REST (crm.item.update / tasks) em diagnóstico
# BITRIX_DEBUG_REST=1
