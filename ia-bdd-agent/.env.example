# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env não é versionado (contém segredos).

BITRIX_WEBHOOK=https://SEU_DOMINIO.bitrix24.com.br/rest/USER/TOKEN

# Opcional: imprime JSON detalhado do CRM no console
# DEBUG_BITRIX=1

# --- SPA pelo título (ex.: Desenvolvimento Q.A. ou Teste Q.A.) ---
# BITRIX_SMART_PROCESS_TITLE=Desenvolvimento Q.A.
# BITRIX_SMART_PROCESS_TITLE=Teste Q.A.
# BITRIX_STAGE_NAME=Novo Teste
# (opcional) BITRIX_CATEGORY_ID=0
# (opcional) filtro manual: BITRIX_LIST_FILTER_JSON={"STAGE_ID":"DTxxxx_STAGE_y:CODE"}
# Liste tipos e estágios: npm run bitrix:context
# BITRIX_ENTITY_TYPE_ID=1276
# Após gerar o BDD, gravar no CRM (campo "Teste Q.A.", "Cenários QA", etc.). Desligar: BITRIX_PUSH_BDD_TO_UF=0
# Código exato do campo no REST (recomendado). Ex.: ufCrm94TesteQa — use npm run bitrix:context + rede do navegador se tiver dúvida
# BITRIX_UF_BDD_FIELD=ufCrm94TesteQa
# (equivalente) BITRIX_UF_TESTE_QA=ufCrm94TesteQa  ou  BITRIX_UF_CENARIOS_QA=ufCrm94CenariosQa
# Lista do Bitrix: tamanho de página (1–500; padrão 100). A lista é buscada em páginas até acabar.
# BITRIX_LIST_PAGE_SIZE=100

# (opcional) Mesmo BDD nas tarefas Bitrix atreladas ao card (UF_CRM_TASK) — precisa UF de texto na TAREFA
# BITRIX_TASK_UF_BDD_FIELD=ufTaskSeuCodigoAqui
# Descoberta automática do UF em tasks.task.get (padrão ligada). Desligar: BITRIX_TASK_UF_AUTO_DISCOVER=0
# Se o get não retornar UFs, liste: BITRIX_TASK_GET_SELECT=ufTaskCampo1,ufTaskCampo2
# Se o vínculo não for encontrado automaticamente, valor exato de UF_CRM_TASK (use {{id}}, {{entityTypeId}}, {{symbol}})
# BITRIX_UF_CRM_TASK_VALUE={{symbol}}_{{id}}
# Desligar gravação em tarefas: BITRIX_PUSH_BDD_TO_LINKED_TASKS=0

# Logar corpo da resposta REST (crm.item.update / tasks) em diagnóstico
# BITRIX_DEBUG_REST=1
