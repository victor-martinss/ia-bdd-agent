# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env não é versionado (contém segredos).

BITRIX_WEBHOOK=https://SEU_DOMINIO.bitrix24.com.br/rest/USER/TOKEN

# Opcional: imprime JSON detalhado do CRM no console
# DEBUG_BITRIX=1

# --- SPA pelo título (ex.: Desenvolvimento Q.A. ou Teste Q.A.) ---
# BITRIX_SMART_PROCESS_TITLE=Desenvolvimento Q.A.
# BITRIX_SMART_PROCESS_TITLE=Teste Q.A.
# Colunas QA (todas as categorias/squads do SPA):
# BITRIX_QA_STAGE_NAMES=Novo Teste,Teste de Q.A,Testes de Q.A,Pronto para teste
# (legado) BITRIX_STAGE_NAME=Novo Teste
# Colunas de desenvolvimento (não recebem cenários no campo QA):
# BITRIX_DEV_STAGE_NAMES=Em Desenvolvimento,Testes em Desenvolvimento
# (opcional) BITRIX_CATEGORY_ID=0
# (opcional) filtro manual: BITRIX_LIST_FILTER_JSON={"STAGE_ID":"DTxxxx_STAGE_y:CODE"}
# Liste tipos e estágios: npm run bitrix:context
# SPA principal (fila QA do poll). Outros processos: passe o id na URL (type/1294/…)
# BITRIX_ENTITY_TYPE_ID=1276
# Vários SPAs — bdd:item tenta achar o card em cada um se NOT_FOUND:
# BITRIX_ENTITY_TYPE_IDS=1276,1294
# Após gerar o BDD, gravar no CRM (campo "Teste Q.A.", "Cenários QA", etc.). Desligar: BITRIX_PUSH_BDD_TO_UF=0
# Código REST do campo (recomendado). Vários SPA = lista separada por vírgula (ordem de tentativa):
# • entityTypeId 1294 (ex.: Squad DICOM / type/1294/) → ufCrm100*
# • entityTypeId 1276 (chamados NGF / type/1276/) → ufCrm94*
BITRIX_UF_BDD_FIELD=ufCrm100CenariosQa,ufCrm94CenariosQa
# (equivalente) BITRIX_UF_CENARIOS_QA ou BITRIX_UF_TESTE_QA
# Lista do Bitrix: tamanho de página (1–500; padrão 100). A lista é buscada em páginas até acabar.
# BITRIX_LIST_PAGE_SIZE=100

# (opcional) Mesmo BDD nas tarefas Bitrix atreladas ao card (UF_CRM_TASK) — precisa UF de texto na TAREFA
# BITRIX_TASK_UF_BDD_FIELD=ufTaskSeuCodigoAqui
# Descoberta automática do UF em tasks.task.get (padrão ligada). Desligar: BITRIX_TASK_UF_AUTO_DISCOVER=0
# Se o get não retornar UFs, liste: BITRIX_TASK_GET_SELECT=ufTaskCampo1,ufTaskCampo2
# Se crm.type.list falhar (400), informe o símbolo do SPA manualmente (ex.: T82):
# BITRIX_SYMBOL_CODE_SHORT=T82
# Valor exato de UF_CRM_TASK na tarefa (use {{id}}, {{entityTypeId}}, {{symbol}}):
# BITRIX_UF_CRM_TASK_VALUE={{symbol}}_{{id}}
# Desligar gravação em tarefas Bitrix: BITRIX_PUSH_BDD_TO_LINKED_TASKS=0
# Desligar gravação em itens CRM filhos: BITRIX_PUSH_BDD_TO_LINKED_CRM_ITEMS=0

# Poll: reprocessar IDs específicos (remove do poll-state e gera de novo)
# BDD_POLL_FORCE_IDS=360
# Poll: reprocessar todos os itens da fila a cada tick
# BDD_POLL_REPROCESS_IN_QUEUE=1

# Logar corpo da resposta REST (crm.item.update / tasks) em diagnóstico
# BITRIX_DEBUG_REST=1
